{
  "name": "inkflow-theme",
  "version": "3.5.0",
  "description": "Inkflow Blog Theme Template",
  "license": "CC-BY-4.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build && prettier --write \"dist/**/*.{html,css,js}\"",
    "icons": "node scripts/generate-icons.mjs",
    "preview": "vite preview",
    "release": "npm run check && node scripts/release.mjs",
    "lint": "eslint src/assets/js/**/*.js",
    "style:lint": "stylelint \"src/assets/css/**/*.css\"",
    "style:fix": "stylelint \"src/assets/css/**/*.css\" --fix",
    "quality": "node scripts/quality-check.mjs",
    "a11y:check": "node scripts/a11y-check.mjs",
    "seo:check": "node scripts/seo-check.mjs",
    "version:check": "node scripts/version-check.mjs",
    "dist:check": "node scripts/dist-check.mjs",
    "check": "npm run lint && npm run style:lint && npm run quality && npm run a11y:check && npm run seo:check && npm run version:check && npm run build && npm run dist:check",
    "smoke": "node scripts/run-smoke.mjs",
    "format": "prettier --write \"src/**/*.{css,js,html}\""
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "purgecss": "^8.0.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.2.1",
    "vite-plugin-handlebars": "^2.0.3"
  },
  "overrides": {
    "js-yaml": "^4.2.0"
  }
}
