{
  "name": "inkflow-theme",
  "version": "3.2.0",
  "description": "Inkflow Blog Theme Template",
  "scripts": {
    "dev": "vite",
    "build": "vite build && prettier --write \"dist/**/*.{html,css,js}\"",
    "preview": "vite preview",
    "release": "npm run build && node scripts/release.mjs",
    "lint": "eslint src/assets/js/**/*.js",
    "format": "prettier --write \"src/**/*.{css,js,html}\""
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "vite": "^5.2.0",
    "vite-plugin-handlebars": "^2.0.3",
    "vite-plugin-purgecss": "^0.2.13"
  }
}
